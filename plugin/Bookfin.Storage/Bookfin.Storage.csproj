<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Bookfin.Storage</AssemblyName>
    <Version>0.1.1</Version>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>none</DebugType>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="MediaBrowser.Common" HintPath="$(JellyfinDir)/MediaBrowser.Common.dll" Private="false" />
    <Reference Include="MediaBrowser.Controller" HintPath="$(JellyfinDir)/MediaBrowser.Controller.dll" Private="false" />
    <Reference Include="MediaBrowser.Model" HintPath="$(JellyfinDir)/MediaBrowser.Model.dll" Private="false" />
    <Reference Include="Jellyfin.Api" HintPath="$(JellyfinDir)/Jellyfin.Api.dll" Private="false" />
    <Reference Include="Microsoft.Data.Sqlite" HintPath="$(JellyfinDir)/Microsoft.Data.Sqlite.dll" Private="false" />
  </ItemGroup>
</Project>
