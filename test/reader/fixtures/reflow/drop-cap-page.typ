#set document(title: "An opening letter", date: none)
#set page(width: 160pt, height: 240pt, margin: 12pt)
#set text(font: "Libertinus Serif", size: 9pt, lang: "en")
#set par(justify: false, leading: 3pt)

#grid(
  columns: (28pt, 1fr),
  column-gutter: 2pt,
  ellipse(width: 26pt, height: 34pt, stroke: 3pt),
  [NCE upon a quiet morning the reader opened a book beside the window.
  Its opening letter stood beside the first lines. The story continued
  across the page, and every printed word kept its place in the story.
  A later line returned to the full width below the opening letter.
  The reader could leave the book and find the same words on returning.],
)
