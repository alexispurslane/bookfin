#!/usr/bin/env bash
set -euo pipefail

if [[ ${BOOKFIN_NIX_SHELL:-} != 1 ]]; then
  printf 'Run through the project shell: nix develop --command bash tool/bookfin <command>\n' >&2
  exit 1
fi
cd "$(dirname "$0")/.."
command=${1:-help}
if (( $# > 0 )); then shift; fi

case "$command" in
  doctor)
    flutter doctor -v
    ;;
  test)
    bash test/sdk_link_test.sh
    bash test/sdk_platform_test.sh
    if [[ $(uname -s) == Darwin ]]; then
      bash test/darwin_native_tools_test.sh
    else
      printf 'SKIP: darwin_native_tools_test.sh tests the macOS SDK and signer, which only the macOS shell has.\n'
    fi
    bash test/native/ocr_worker_test.sh
    bash test/native/speech_package_test.sh
    flutter test --reporter expanded
    ;;
  analyze)
    flutter analyze
    ;;
  build-web)
    flutter build web "$@"
    ;;
  build-android)
    python3 tool/reader/native_package.py prepare
    flutter build apk --debug --target-platform android-arm64 "$@"
    python3 tool/reader/native_package.py verify build/app/outputs/flutter-apk/app-debug.apk
    python3 tool/reader/ocr_package.py verify build/app/outputs/flutter-apk/app-debug.apk
    python3 tool/reader/speech_package.py verify build/app/outputs/flutter-apk/app-debug.apk
    ;;
  build-macos|run-macos|accept-macos)
    if [[ ${BOOKFIN_MACOS_SHELL:-} != 1 ]]; then
      printf 'Run through the macOS shell: nix develop .#macos --command bash tool/bookfin %s\n' "$command" >&2
      exit 1
    fi
    python3 tool/reader/native_package.py prepare-macos
    case "$command" in
      build-macos) flutter build macos --debug "$@" ;;
      run-macos) flutter run -d macos "$@" ;;
      accept-macos)
        # Each build gets a new ad-hoc signature, and the login keychain asks
        # the user before a new build reads an item that an older build
        # saved. The run starts without the saved sign-in and signs out at
        # the end, so no dialog blocks it.
        for item in bookfin.session.v1 bookfin.device.v1; do
          security delete-generic-password -s flutter_secure_storage_service -a "$item" >/dev/null 2>&1 || true
        done
        flutter test integration_test/macos_desktop_test.dart -d macos --reporter expanded "$@"
        ;;
    esac
    ;;
  build-probe-android)
    flutter build apk --debug --target-platform android-arm64 --target tool/reload_probe.dart "$@"
    ;;
  web|probe-web)
    target=lib/main.dart
    if [[ "$command" == probe-web ]]; then target=tool/reload_probe.dart; fi
    flutter run -d web-server --target "$target" --web-hostname 127.0.0.1 --web-port 7357 "$@"
    ;;
  attach-android)
    device=${1:?Pass the Android device ID returned by T3.}
    shift
    flutter attach -d "$device" "$@"
    ;;
  emulator-create)
    avd_home=${ANDROID_AVD_HOME:-"$HOME/.android/avd"}
    if [[ -e "$avd_home/bookfin-api36.ini" || -e "$avd_home/bookfin-api36.avd" ]]; then
      printf 'bookfin-api36 already exists. It was not changed.\n'
      exit 0
    fi
    printf 'no\n' | avdmanager create avd --name bookfin-api36 --package 'system-images;android-36;google_apis;arm64-v8a' --device pixel_7
    config="$avd_home/bookfin-api36.avd/config.ini"
    image="$ANDROID_HOME/system-images/android-36/google_apis/arm64-v8a/"
    awk -v image="$image" '
      /^image.sysdir.1=/ { print "image.sysdir.1=" image; next }
      { print }
    ' "$config" > "$config.bookfin"
    mv "$config.bookfin" "$config"
    ;;
  link-t3-sdk)
    bash tool/link-t3-sdk "$@"
    ;;
  *)
    printf 'Commands: doctor, test, analyze, build-web, build-android, build-probe-android, build-macos, run-macos, accept-macos, web, probe-web, attach-android <id>, emulator-create, link-t3-sdk <host-sdk>\n'
    [[ "$command" == help ]]
    ;;
esac
